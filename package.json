    "./speech": "./lib/speech.js",
    "./images": "./lib/images.js",
    "./image-tools": "./lib/image-tools.js",
    "./media": "./lib/media.js",
    "./timeline": "./lib/timeline.js",
    "./providers": "./lib/providers.js",
    "./video-runner": "./lib/video-runner.js",
    "./dsh": "./lib/dsh.js",
    "./office-preview": "./lib/office-preview.js",
    "./office-preview-client": "./lib/office-preview-client.js",
    "./office-design": "./lib/office-design.js",
    "./creation-guidance": "./lib/creation-guidance.js",
    "./presentation-contract": "./lib/presentation-contract.js",
    "./music": "./lib/music.js",
    "./runtime": "./lib/runtime.js",
    "./remotion": "./lib/remotion.js",
    "./transcription": "./lib/transcription.js",
    "./transcription-openai": "./lib/transcription-openai.js",
    "./transcription-whisper": "./lib/transcription-whisper.js",
